PORT=3000
BASE_URL=http://localhost:3000
# Create a Trakt application; redirect URI must be BASE_URL/auth/trakt/callback.
TRAKT_CLIENT_ID=
# Generate with: bun -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
ENCRYPTION_KEY=
DATABASE_PATH=./data/taste.sqlite
# Optional: restrict new registrations on your hosted instance.
INVITE_CODE=
# Optional: enables device-code login instead of redirect/PKCE.
# This is the SERVER's Trakt app secret, never a user's AI key.
TRAKT_CLIENT_SECRET=
# Only enable behind a proxy that overwrites X-Real-IP, with a private upstream port.
TRUST_PROXY=false
# Hosted example: BASE_URL=https://addons.grosst.cc/taste
